#!/usr/bin/env bash
set -euo pipefail

# ==============================================================================
# CLOUD-INIT TEMPLATE
# Auto-configures Debian 12 as a WireGuard hub: UFW, WireGuard, Fail2Ban,
# and a boot-time security update service.
# ==============================================================================

NEW_USER="wgadmin"

export DEBIAN_FRONTEND=noninteractive
apt-get update -qq
apt-get upgrade -y -qq -o Dpkg::Options::="--force-confdef" -o Dpkg::Options::="--force-confold"
apt-get install -y wireguard iptables ufw fail2ban python3-systemd curl unzip unattended-upgrades
echo 'unattended-upgrades unattended-upgrades/enable_auto_updates boolean true' | debconf-set-selections
dpkg-reconfigure -f noninteractive unattended-upgrades

echo "Installing AWS CLI v2..."
cd /tmp
curl -fsSL "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip" -o "awscliv2.zip"
EXPECTED_SHA256=$(curl -fsSL "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip.sha256")
ACTUAL_SHA256=$(sha256sum awscliv2.zip | awk '{print $1}')
if [ "$EXPECTED_SHA256" != "$ACTUAL_SHA256" ]; then
    echo "ERROR: AWS CLI checksum verification failed!"
    exit 1
fi
unzip -q awscliv2.zip
./aws/install
cd /
rm -rf /tmp/aws /tmp/awscliv2.zip

if id "$${NEW_USER}" &>/dev/null; then
    echo "User $${NEW_USER} already exists."
else
    if getent group "$${NEW_USER}" &>/dev/null; then
        useradd -m -s /bin/bash -g "$${NEW_USER}" "$${NEW_USER}" || { echo "ERROR: useradd failed"; exit 1; }
    else
        useradd -m -s /bin/bash "$${NEW_USER}" || { echo "ERROR: useradd failed"; exit 1; }
    fi
    echo "User $${NEW_USER} created."
fi

echo "Setting up sudo for $${NEW_USER}..."
echo "$${NEW_USER} ALL=(ALL) NOPASSWD: /usr/bin/wg, /usr/sbin/ufw, /usr/bin/journalctl" > "/etc/sudoers.d/$${NEW_USER}"
chmod 0440 "/etc/sudoers.d/$${NEW_USER}"
echo "Sudo configured for $${NEW_USER}."

echo "Setting up SSH for $${NEW_USER}..."
mkdir -p "/home/$${NEW_USER}/.ssh" || { echo "ERROR: mkdir failed"; exit 1; }
echo "${ssh_public_key}" > "/home/$${NEW_USER}/.ssh/authorized_keys" || { echo "ERROR: echo failed"; exit 1; }
chown -R "$${NEW_USER}:$${NEW_USER}" "/home/$${NEW_USER}/.ssh" || { echo "ERROR: chown failed"; exit 1; }
chmod 700 "/home/$${NEW_USER}/.ssh" || { echo "ERROR: chmod .ssh failed"; exit 1; }
chmod 600 "/home/$${NEW_USER}/.ssh/authorized_keys" || { echo "ERROR: chmod authorized_keys failed"; exit 1; }
chmod 755 "/home/$${NEW_USER}" || { echo "ERROR: chmod home failed"; exit 1; }

echo "SSH key installed for $${NEW_USER}."

cat <<EOM > /etc/sysctl.d/99-security-routing.conf
net.ipv4.ip_forward=1
net.ipv4.conf.all.accept_source_route=0
net.ipv4.conf.default.accept_source_route=0
net.ipv4.conf.all.rp_filter=1
net.ipv4.conf.default.rp_filter=1
net.ipv4.conf.all.log_martians=1
net.ipv4.conf.default.log_martians=1
net.ipv6.conf.all.disable_ipv6=1
net.ipv6.conf.default.disable_ipv6=1
EOM
sysctl --system

sed -i 's/DEFAULT_FORWARD_POLICY="DROP"/DEFAULT_FORWARD_POLICY="ACCEPT"/' /etc/default/ufw
ufw default deny incoming
ufw default allow outgoing
ufw allow 50022/tcp comment 'SSH emergency access'
ufw allow 51920/udp comment 'WireGuard tunnel'
ufw allow in on wg0 comment 'Trust internal VPN traffic'
ufw --force enable

ETH_IF=$(ip route list default | awk '{print $5}' | head -n 1)

mkdir -p /etc/wireguard
chmod 700 /etc/wireguard

echo "Fetching WireGuard server key from SSM..."
for i in 1 2 3 4 5; do
    if WG_SERVER_KEY=$(aws ssm get-parameter \
      --name "/wg-bastion/server-private-key" \
      --region "${region}" \
      --with-decryption \
      --query "Parameter.Value" \
      --output text 2>/dev/null); then
        break
    fi
    echo "SSM fetch attempt $i failed, waiting 10s for IAM propagation..."
    sleep 10
done

if [ -z "$WG_SERVER_KEY" ]; then
    echo "CRITICAL: Failed to fetch server key from SSM after 5 attempts."
    echo "Check IAM role permissions and SSM parameter existence."
    exit 1
fi

%{ for name, peer in wg_peers ~}
echo "Fetching PSK for peer '${name}' from SSM..."
for i in 1 2 3 4 5; do
    if PEER_PSK_${replace(name, "-", "_")}=$(aws ssm get-parameter \
      --name "/wg-bastion/peer-psk/${name}" \
      --region "${region}" \
      --with-decryption \
      --query "Parameter.Value" \
      --output text 2>/dev/null); then
        break
    fi
    echo "SSM fetch attempt $i for ${name} failed, waiting 10s..."
    sleep 10
done

if [ -z "$${PEER_PSK_${replace(name, "-", "_")}}" ]; then
    echo "CRITICAL: Failed to fetch PSK for peer '${name}' after 5 attempts."
    exit 1
fi
%{ endfor ~}

cat <<EOM > /etc/wireguard/wg0.conf
[Interface]
PrivateKey = $${WG_SERVER_KEY}
ListenPort = 51920
Address = 10.10.0.1/24

PostUp   = iptables -A FORWARD -i wg0 -j ACCEPT; iptables -t nat -A POSTROUTING -o $${ETH_IF} -j MASQUERADE
PostDown = iptables -D FORWARD -i wg0 -j ACCEPT; iptables -t nat -D POSTROUTING -o $${ETH_IF} -j MASQUERADE

%{ for name, peer in wg_peers ~}
[Peer]
# ${name}
PublicKey    = ${peer.public_key}
PresharedKey = $${PEER_PSK_${replace(name, "-", "_")}}
AllowedIPs   = ${peer.ip}/32
PersistentKeepalive = 25

%{ endfor ~}
EOM

chmod 600 /etc/wireguard/wg0.conf
systemctl enable wg-quick@wg0
systemctl start wg-quick@wg0

cat <<EOM > /etc/fail2ban/jail.local
[DEFAULT]
backend = systemd
banaction = ufw
findtime = 10m

[sshd]
enabled  = true
port     = 50022
filter   = sshd
maxretry = 3
bantime  = 24h
EOM
systemctl enable fail2ban
systemctl restart fail2ban

sed -i 's/^#\?Port.*/Port 50022/'                               /etc/ssh/sshd_config
sed -i 's/^#\?PermitRootLogin.*/PermitRootLogin no/'            /etc/ssh/sshd_config
sed -i 's/^#\?PasswordAuthentication.*/PasswordAuthentication no/' /etc/ssh/sshd_config
sed -i 's/^#\?PubkeyAuthentication.*/PubkeyAuthentication yes/' /etc/ssh/sshd_config
sed -i 's/^#\?X11Forwarding.*/X11Forwarding no/'                /etc/ssh/sshd_config
sed -i 's/^#\?AllowAgentForwarding.*/AllowAgentForwarding no/' /etc/ssh/sshd_config
echo "AllowUsers $${NEW_USER}" >> /etc/ssh/sshd_config
echo "MaxAuthTries 3"          >> /etc/ssh/sshd_config
echo "LoginGraceTime 30"       >> /etc/ssh/sshd_config

if ! sshd -t; then
    echo "CRITICAL: sshd_config has a syntax error — check /etc/ssh/sshd_config and fix before rebooting."
    exit 1
fi
# On socket-activated sshd (Debian 13+/Ubuntu) the listening port comes from
# ssh.socket, not sshd_config, so the Port directive above would be ignored and
# the only allowed SG port (50022) would never be served. Debian 12 uses the
# classic always-on service, so this block is a no-op there.
if systemctl is-enabled ssh.socket &>/dev/null; then
    systemctl disable --now ssh.socket
    systemctl enable ssh.service
fi

echo "SSH configuration validated. Restarting SSH..."
systemctl restart ssh
echo "SSH restarted successfully."

cat << 'EOF' > /usr/local/bin/startup-update.sh
#!/usr/bin/env bash
set -euo pipefail
export DEBIAN_FRONTEND=noninteractive
unattended-upgrades
EOF
chmod +x /usr/local/bin/startup-update.sh

cat << 'EOF' > /etc/systemd/system/startup-update.service
[Unit]
Description=Install security updates on boot
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/startup-update.sh
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
EOF
systemctl daemon-reload
systemctl enable startup-update.service

if [ -f /var/run/reboot-required ]; then
    echo "Security updates require a reboot. Rebooting now..."
    systemctl reboot
fi
