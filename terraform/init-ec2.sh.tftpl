#!/usr/bin/env bash
set -euo pipefail

# ==============================================================================
# CLOUD-INIT TEMPLATE
# Auto-configures Debian 12 as a Tailscale DERP relay + Headscale coordinator.
# No WireGuard private keys on this instance — only public keys in Headscale.
# ==============================================================================

NEW_USER="wgadmin"

export DEBIAN_FRONTEND=noninteractive
apt-get update -qq
apt-get upgrade -y -qq -o Dpkg::Options::="--force-confdef" -o Dpkg::Options::="--force-confold"
apt-get install -y iptables ufw fail2ban python3-systemd curl unzip ca-certificates gnupg unattended-upgrades
echo 'unattended-upgrades unattended-upgrades/enable_auto_updates boolean true' | debconf-set-selections
dpkg-reconfigure -f noninteractive unattended-upgrades

echo "Installing AWS CLI v2..."
cd /tmp
curl -fsSL "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip" -o "awscliv2.zip"
EXPECTED_SHA256=$(curl -fsSL "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip.sha256")
ACTUAL_SHA256=$(sha256sum awscliv2.zip | awk '{print $1}')
if [ "$EXPECTED_SHA256" != "$ACTUAL_SHA256" ]; then
    echo "ERROR: AWS CLI checksum verification failed!"
    exit 1
fi
unzip -q awscliv2.zip
./aws/install
cd /
rm -rf /tmp/aws /tmp/awscliv2.zip

if id "$${NEW_USER}" &>/dev/null; then
    echo "User $${NEW_USER} already exists."
else
    if getent group "$${NEW_USER}" &>/dev/null; then
        useradd -m -s /bin/bash -g "$${NEW_USER}" "$${NEW_USER}" || { echo "ERROR: useradd failed"; exit 1; }
    else
        useradd -m -s /bin/bash "$${NEW_USER}" || { echo "ERROR: useradd failed"; exit 1; }
    fi
    echo "User $${NEW_USER} created."
fi

echo "Setting up sudo for $${NEW_USER}..."
echo "$${NEW_USER} ALL=(ALL) NOPASSWD: /usr/bin/journalctl, /usr/bin/headscale preauthkeys *, /usr/bin/headscale nodes *, /usr/bin/headscale users *" > "/etc/sudoers.d/$${NEW_USER}"
chmod 0440 "/etc/sudoers.d/$${NEW_USER}"
echo "Sudo configured for $${NEW_USER}."

echo "Setting up SSH for $${NEW_USER}..."
mkdir -p "/home/$${NEW_USER}/.ssh" || { echo "ERROR: mkdir failed"; exit 1; }
echo "${ssh_public_key}" > "/home/$${NEW_USER}/.ssh/authorized_keys" || { echo "ERROR: echo failed"; exit 1; }
chown -R "$${NEW_USER}:$${NEW_USER}" "/home/$${NEW_USER}/.ssh" || { echo "ERROR: chown failed"; exit 1; }
chmod 700 "/home/$${NEW_USER}/.ssh" || { echo "ERROR: chmod .ssh failed"; exit 1; }
chmod 600 "/home/$${NEW_USER}/.ssh/authorized_keys" || { echo "ERROR: chmod authorized_keys failed"; exit 1; }
chmod 755 "/home/$${NEW_USER}" || { echo "ERROR: chmod home failed"; exit 1; }

echo "SSH key installed for $${NEW_USER}."

cat <<EOM > /etc/sysctl.d/99-security-routing.conf
net.ipv4.ip_forward=1
net.ipv4.conf.all.accept_source_route=0
net.ipv4.conf.default.accept_source_route=0
net.ipv4.conf.all.rp_filter=1
net.ipv4.conf.default.rp_filter=1
net.ipv4.conf.all.log_martians=1
net.ipv4.conf.default.log_martians=1
net.ipv6.conf.all.disable_ipv6=1
net.ipv6.conf.default.disable_ipv6=1
EOM
sysctl --system

ufw default deny incoming
ufw default allow outgoing
ufw allow 50022/tcp comment 'SSH maintenance access'
ufw allow 443/tcp comment 'Headscale API + DERP HTTPS'
ufw allow 3478/udp comment 'DERP STUN'
ufw --force enable

EIP=$(curl -fsSL http://169.254.169.254/latest/meta-data/public-ipv4 2>/dev/null || echo "")
if [ -z "$EIP" ]; then
    echo "CRITICAL: Could not determine Elastic IP from instance metadata."
    exit 1
fi
echo "Detected Elastic IP: $${EIP}"

echo "Installing Headscale..."
HEADSCALE_VERSION="0.23.0"
curl -fsSL "https://github.com/juanfont/headscale/releases/download/v$${HEADSCALE_VERSION}/headscale_$${HEADSCALE_VERSION}_linux_amd64.deb" -o /tmp/headscale.deb
curl -fsSL "https://github.com/juanfont/headscale/releases/download/v$${HEADSCALE_VERSION}/headscale_$${HEADSCALE_VERSION}_checksums.txt" -o /tmp/checksums.txt
EXPECTED_SHA256=$(grep "headscale_$${HEADSCALE_VERSION}_linux_amd64.deb" /tmp/checksums.txt | awk '{print $1}')
ACTUAL_SHA256=$(sha256sum /tmp/headscale.deb | awk '{print $1}')
if [ "$EXPECTED_SHA256" != "$ACTUAL_SHA256" ]; then
    echo "ERROR: Headscale checksum verification failed!"
    echo "Expected: $EXPECTED_SHA256"
    echo "Actual: $ACTUAL_SHA256"
    exit 1
fi
apt install -y /tmp/headscale.deb
rm -f /tmp/headscale.deb /tmp/checksums.txt

if ! id headscale &>/dev/null; then
    useradd -r -s /usr/sbin/nologin headscale
fi

mkdir -p /etc/headscale /var/lib/headscale
chmod 750 /etc/headscale /var/lib/headscale

cat <<EOM > /etc/headscale/config.yaml
server_url: https://$${EIP}:443
listen_addr: 127.0.0.1:8080
metrics_listen_addr: 127.0.0.1:9090
private_key_path: /var/lib/headscale/private.key
noise:
  private_key_path: /var/lib/headscale/noise_private.key
ip_prefixes:
  - 100.64.0.0/10
db_type: sqlite3
db_path: /var/lib/headscale/db.sqlite
derp:
  server:
    enabled: true
    region_id: 999
    region_code: "wg-bastion"
    region_name: "WG Bastion DERP"
    stun_listen_addr: "0.0.0.0:3478"
    private_key_path: /var/lib/headscale/derp_private.key
dns:
  base_domain: wg-bastion.local
EOM

chown -R headscale:headscale /var/lib/headscale /etc/headscale
chmod 640 /etc/headscale/config.yaml

systemctl enable headscale
systemctl start headscale

echo "Waiting for Headscale to initialize..."
sleep 5

echo "Installing Caddy for TLS termination..."
apt install -y debian-keyring debian-archive-keyring apt-transport-https curl
mkdir -p /etc/apt/keyrings
curl -1sLf 'https://dl.cloudsmith.io/public/caddy/stable/gpg.key' | gpg --dearmor -o /etc/apt/keyrings/caddy-stable-archive-keyring.gpg
echo "deb [signed-by=/etc/apt/keyrings/caddy-stable-archive-keyring.gpg] https://dl.cloudsmith.io/public/caddy/stable/deb/debian any-version main" > /etc/apt/sources.list.d/caddy-stable.list
apt update
apt install -y caddy

cat <<EOM > /etc/caddy/Caddyfile
https://$${EIP}:443 {
    tls internal
    reverse_proxy localhost:8080
}
EOM

systemctl enable caddy
systemctl restart caddy

echo "Waiting for Caddy to initialize..."
sleep 3

echo "Extracting Caddy CA certificate for clients..."
CADDY_CA_CERT=$(find /var/lib/caddy -name "root.crt" 2>/dev/null | head -1)
if [ -n "$CADDY_CA_CERT" ]; then
    cp "$CADDY_CA_CERT" /etc/headscale/ca.crt
    chown $${NEW_USER}:$${NEW_USER} /etc/headscale/ca.crt
    chmod 644 /etc/headscale/ca.crt
    echo "CA certificate available at /etc/headscale/ca.crt"
else
    echo "WARNING: Could not find Caddy CA certificate."
fi

echo "Creating default Headscale user..."
headscale users create default || echo "User 'default' already exists."

echo "Headscale is running with TLS."

cat << 'EOF' > /usr/local/bin/startup-update.sh
#!/usr/bin/env bash
set -euo pipefail
export DEBIAN_FRONTEND=noninteractive
unattended-upgrades
EOF
chmod +x /usr/local/bin/startup-update.sh

cat << 'EOF' > /etc/systemd/system/startup-update.service
[Unit]
Description=Install security updates on boot
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/startup-update.sh
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
EOF
systemctl daemon-reload
systemctl enable startup-update.service

sed -i 's/^#\?Port.*/Port 50022/'                               /etc/ssh/sshd_config
sed -i 's/^#\?PermitRootLogin.*/PermitRootLogin no/'            /etc/ssh/sshd_config
sed -i 's/^#\?PasswordAuthentication.*/PasswordAuthentication no/' /etc/ssh/sshd_config
sed -i 's/^#\?PubkeyAuthentication.*/PubkeyAuthentication yes/' /etc/ssh/sshd_config
sed -i 's/^#\?X11Forwarding.*/X11Forwarding no/'                /etc/ssh/sshd_config
sed -i 's/^#\?AllowAgentForwarding.*/AllowAgentForwarding no/' /etc/ssh/sshd_config
echo "AllowUsers $${NEW_USER}" >> /etc/ssh/sshd_config
echo "MaxAuthTries 3"          >> /etc/ssh/sshd_config
echo "LoginGraceTime 30"       >> /etc/ssh/sshd_config

if ! sshd -t; then
    echo "CRITICAL: sshd_config has a syntax error."
    exit 1
fi
if systemctl is-enabled ssh.socket &>/dev/null; then
    systemctl disable --now ssh.socket
    systemctl enable ssh.service
fi

echo "SSH configuration validated. Restarting SSH..."
systemctl restart ssh
echo "SSH restarted successfully."

if [ -f /var/run/reboot-required ]; then
    echo "Security updates require a reboot. Rebooting now..."
    systemctl reboot
fi
